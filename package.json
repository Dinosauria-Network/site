{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "enrich": "NODE_OPTIONS=\"-r dotenv/config\" node scripts/enrich-cache.mjs",
    "scrape": "NODE_OPTIONS=\"-r dotenv/config\" node scripts/auto-scrape.mjs",
    "db:push": "npx drizzle-kit push",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "db:seed": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/seed.ts",
    "db:studio": "npx drizzle-kit studio",
    "ingest:europe-pmc": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/ingest-db.ts --adapter europe-pmc",
    "ingest:arxiv": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/ingest-db.ts --adapter arxiv",
    "ingest:crossref": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/ingest-crossref.ts",
    "ingest:journals": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/ingest-db.ts --adapter crossref-journals",
    "ingest:rss": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/ingest-db.ts --adapter rss",
    "ingest:check": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/run-ingestion.ts",
    "backfill:abstracts": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/backfill-abstracts.ts",
    "editorial:generate": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/classify-and-prune.ts",
    "editorial:classify": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/classify-and-prune.ts",
    "editorial:retry": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/test-jev-style.ts",
    "editorial:propose": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/propose.ts",
    "editorial:pending": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/pending.ts",
    "editorial:status": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/status.ts",
    "editorial:publish": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/publish.ts",
    "editorial:autopublish": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/autopublish.ts",
    "editorial:unpublish": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/unpublish.ts",
    "editorial:reject": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/reject.ts",
    "editorial:attach-image": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/attach-image.ts",
    "source:health": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/test-jev-style.ts",
    "retraction:check": "NODE_OPTIONS=\"-r dotenv/config\" npx tsx scripts/test-jev-style.ts",
    "enrich:locations": "npx tsx scripts/enrich-genus-locations.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "article-parser": "^7.2.6-rc1",
    "d3-geo": "^3.1.2",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rss": "^1.2.2",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/rss": "^0.0.32",
    "@types/topojson-client": "^3.1.5",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sass": "^1.107.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
